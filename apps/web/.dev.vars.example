# Copy to .dev.vars for local dev (read by wrangler / Nitro's Cloudflare emulation).
# In production set these with `wrangler secret put <NAME>`.

# Session cookie encryption, 32+ characters (openssl rand -hex 32).
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-of-32-plus-chars

# Optional OAuth providers (buttons appear on /login when set)
# Callback URLs: http://localhost:3000/auth/github and /auth/google
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Digests and team invites. Without a key, emails are printed to the dev server log.
# RESEND_API_KEY=
# EMAIL_FROM="Mochiscout <hello@example.com>"

# Self-host: extra emails allowed to sign up after the first user
# ALLOWED_EMAILS=

# Contact URL in the User-Agent sent to reddit.com (use your fork / site)
# CONTACT_URL=https://github.com/you/your-fork

# Search provider for discovery: tinyfish (default, free key) or brave.
# The other provider is used as a fallback when its key is set.
# SEARCH_PROVIDER=tinyfish
# TINYFISH_API_KEY=
# BRAVE_API_KEY=

# LLM (fast tier: claude-haiku-5-5, quality tier: claude-opus-5-5 by default)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic
# LLM_FAST_MODEL=
# LLM_QUALITY_MODEL=

# Public URL of the app: links in emails, Polar checkout redirects
# APP_URL=https://radar.example.com

# Hosted edition only (NUXT_PUBLIC_EDITION=cloud): Polar billing
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
# POLAR_PRODUCT_SOLO=
# POLAR_PRODUCT_PRO=

# Hosted edition: NUXT_PUBLIC_EDITION=cloud. Before launch, NUXT_PUBLIC_WAITLIST=true
# shows a waitlist on the landing page and closes open sign-ups.

# X as a feed source (official API, paid; Pro plan on the hosted edition)
# X_BEARER_TOKEN=
