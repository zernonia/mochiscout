# Copy to .dev.vars for local dev (read by wrangler / Nitro's Cloudflare emulation).
# In production set these with `wrangler secret put <NAME>`.

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth providers (buttons appear on /login when set)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic links and digests. Without a key, emails are printed to the dev server log.
# RESEND_API_KEY=
# EMAIL_FROM="social-radar <hello@example.com>"

# Self-host: extra emails allowed to sign up after the first user
# ALLOWED_EMAILS=

# Contact URL in the User-Agent sent to reddit.com (use your fork / site)
# CONTACT_URL=https://github.com/you/social-radar
