{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mochiscout",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run requests next to the Anthropic API and the D1 primary (both US East). From some
  // edge locations (e.g. Hong Kong) the Anthropic API answers 403 "Request not allowed",
  // and every D1 query is a round trip to ENAM anyway. Static assets still serve from the edge.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  // Keep variables set in the dashboard (NUXT_PUBLIC_EDITION etc.) across deploys.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochiscout",
      // Self-hosting your own copy? Use the id from `wrangler d1 create mochiscout`.
      "database_id": "ea663c06-44e3-4650-97a3-051b68085757",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Self-hosting your own copy? Use the id from `wrangler kv namespace create CACHE`.
      "id": "5de2cc6272c84221be409ad838982cfe"
    }
  ],

  // Cloudflare Email Service for digests and invites; set EMAIL_FROM to an address on an
  // onboarded sending domain. Self-hosting with Resend instead? Remove this and set RESEND_API_KEY.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Single cron trigger; Nitro's scheduledTasks + the `dispatch` task decide what runs.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }

  // Optional (cloud): JOBS queue, consumer max_concurrency 1.
  // "queues": {
  //   "producers": [{ "binding": "JOBS", "queue": "mochiscout-jobs" }],
  //   "consumers": [{ "queue": "mochiscout-jobs", "max_concurrency": 1 }]
  // }
}
