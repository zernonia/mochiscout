{
  "name": "mochiscout",
  "description": "Find people asking for your product on Reddit, Hacker News, Bluesky and X, and reply helpfully without getting banned.",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://mochiscout.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zernonia/mochiscout.git"
  },
  "bugs": "https://github.com/zernonia/mochiscout/issues",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mochiscout/web dev",
    "build": "pnpm --filter @mochiscout/web build",
    "preview": "pnpm --filter @mochiscout/web preview",
    "deploy": "pnpm --filter @mochiscout/web deploy",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @mochiscout/db generate",
    "db:migrate:local": "pnpm --filter @mochiscout/web db:migrate:local",
    "test": "pnpm -r --if-present test",
    "rules:build": "pnpm --filter @mochiscout/rules build",
    "rules:validate": "pnpm --filter @mochiscout/rules validate",
    "rules:sync": "pnpm --filter @mochiscout/core rules:sync"
  }
}
